generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js tables ----------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  restaurants   Restaurant[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Product ----------

enum RestaurantKind {
  FRANCHISE
  INDEPENDENT
}

enum PromoApproval {
  YES
  NO
  UNSURE
}

model Restaurant {
  id                   String          @id @default(cuid())
  ownerId              String
  owner                User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                 String
  kind                 RestaurantKind  @default(FRANCHISE)
  brand                String?
  radiusMiles          Int             @default(3)
  minCateringOrder     Int             @default(10)
  openingHours         String?
  // Brand rules (setup step 4)
  promoApproval        PromoApproval   @default(UNSURE)
  maxDiscountPct       Int             @default(15)
  allowFreeExtra       Boolean         @default(true)
  allowFreeDelivery    Boolean         @default(true)
  allowPercentOff      Boolean         @default(true)
  allowBogo            Boolean         @default(false)
  useBrandCateringMenu Boolean         @default(true)
  setupCompletedAt     DateTime?
  outlets              Outlet[]
  reports              ReportUpload[]
  drafts               Draft[]
  draftJobs            DraftJob[]
  analysisRuns         AnalysisRun[]
  llmCalls             LlmCall[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  leads                Lead[]
  leadScans            LeadScan[]
  events               Event[]
  /// Most emails sent per day from the connected Gmail (warm-up for a new sender)
  sendDailyCap         Int             @default(20)
  gmail                GmailAccount?
  emails               OutboundEmail[]
  suppressions         Suppression[]

  @@index([ownerId])
}

model Outlet {
  id              String     @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  address         String
  latitude        Float?
  longitude       Float?
  /// The address the coordinates were looked up for; re-geocode when it changes
  geocodedAddress String?
  createdAt       DateTime   @default(now())
}

enum ReportStatus {
  READ // parsed, waiting for the owner to confirm
  CONFIRMED // owner said the numbers look right
  FLAGGED // owner said something looks wrong
}

model ReportUpload {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  fileName     String
  reportType   String
  storeNumber  String?
  periodStart  DateTime?    @db.Date
  periodEnd    DateTime?    @db.Date
  status       ReportStatus @default(READ)
  /// The parsed report (see src/lib/reports/types.ts). The original file is not kept.
  data         Json
  createdAt    DateTime     @default(now())

  @@index([restaurantId, reportType, periodEnd])
}

// ---------- Drafts (milestone 2) ----------

enum DraftKind {
  CUSTOMER_OFFER
  CATERING_PITCH
}

enum DraftSource {
  RULES
  AI_ANALYST
}

enum DraftStatus {
  PENDING // waiting in the Approval Inbox
  APPROVED
  SKIPPED
}

/// One suggestion in the Approval Inbox. Numbers come from the owner's
/// confirmed reports; only headline and body are written by the LLM.
model Draft {
  id             String          @id @default(cuid())
  leadId         String?
  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  eventId        String?
  event          Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  restaurantId   String
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kind           DraftKind       @default(CUSTOMER_OFFER)
  /// Which idea produced it: a rule ("welcome", "afternoon-drink"…) or an AI idea ("ai-…")
  offerKey       String
  source         DraftSource     @default(RULES)
  /// The AI analyst's confidence: "low" | "medium" | "high"; null for rule ideas
  confidence     String?
  analysisRunId  String?
  analysisRun    AnalysisRun?    @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  category       String
  title          String
  schedule       String
  why            String
  audience       String
  cost           String
  measure        String
  /// Rule checks shown as ticks, e.g. ["Free extra, no price cut"]
  checks         String[]
  /// Supporting data for the detail panel (e.g. hourly sales bars)
  evidence       Json?
  copyLabel      String
  /// Facts the copywriter may use, so rewrites stay within them
  facts          String[]
  needsCode      Boolean         @default(false)
  headline       String
  body           String
  /// Who wrote headline/body: "template", "ollama:<model>", "anthropic:<model>"
  writtenBy      String
  /// Hash of the facts sent to the writer; the same facts are never drafted twice
  factsHash      String
  rewriteCount   Int             @default(0)
  status         DraftStatus     @default(PENDING)
  /// Catering pitches: where the deal stands after approval
  stage          PipelineStage   @default(NONE)
  stageUpdatedAt DateTime?
  /// The two follow-ups sent if there's no reply: [{"day":4,"body":"…"},{"day":10,"body":"…"}]
  followUps      Json?
  /// First lines of the business's reply, and when it came
  replySnippet   String?
  repliedAt      DateTime?
  /// The owner has dealt with the reply (moved it on in the pipeline)
  replyHandled   Boolean         @default(false)
  emails         OutboundEmail[]
  skipReason     String?
  decidedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([restaurantId, factsHash])
  @@index([restaurantId, status])
}

enum JobKind {
  OFFERS // customer offer ideas from reports
  LEADS // scan the area for businesses and events (no AI, no pitches)
  SUGGEST // AI marks the most promising leads and events
  PITCH // write pitches the owner asked for (one or many at once)
  FOLLOWUPS // write the day-4 and day-10 follow-ups for approved pitches
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Background work to (re)build a restaurant's drafts. Processed one at a time per restaurant.
model DraftJob {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  kind         JobKind    @default(OFFERS)
  /// LEADS only: search the area again even if the last scan is recent
  force        Boolean    @default(false)
  status       JobStatus  @default(QUEUED)
  message      String?
  /// Tries so far; the AI being busy or over its free limit puts the job back with a wait
  attempts     Int        @default(0)
  /// Not before this time (set while waiting for the AI)
  runAfter     DateTime?
  /// PITCH jobs: what to pitch, e.g. [{"leadId":"…"},{"eventId":"…"}]
  payload      Json?
  createdAt    DateTime   @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([status, createdAt])
  @@index([restaurantId, status])
}

/// One row per call to an LLM provider, for cost and error tracking.
model LlmCall {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  provider     String
  model        String
  purpose      String
  /// "ok", "retried-ok", "error", "invalid-output"
  outcome      String
  attempts     Int
  inputTokens  Int?
  outputTokens Int?
  durationMs   Int
  error        String?
  createdAt    DateTime    @default(now())

  @@index([restaurantId, createdAt])
}

enum AnalysisStatus {
  RUNNING
  DONE
  FAILED
}

/// One run of the AI analyst over a restaurant's data: what it looked at,
/// what it found, and which proposals passed or failed the code checks.
model AnalysisRun {
  id                String         @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// "offers" (customer offers from reports) or "leads" (catering pitches)
  purpose           String         @default("offers")
  provider          String
  model             String
  status            AnalysisStatus @default(RUNNING)
  /// Hash of the reports, rules and past decisions; unchanged data reuses the last run
  dataHash          String
  /// Verified findings shown as "AI found this week"
  findings          Json?
  /// Proposals that passed every check
  accepted          Json?
  /// Proposals or findings that failed a check, with the reasons
  rejected          Json?
  /// What the AI decided about each standard idea (keep / change / drop)
  baselineDecisions Json?
  /// Every tool call: name, input, output
  toolLog           Json?
  toolCalls         Int            @default(0)
  inputTokens       Int            @default(0)
  outputTokens      Int            @default(0)
  estimatedCostUsd  Float?
  error             String?
  drafts            Draft[]
  createdAt         DateTime       @default(now())
  finishedAt        DateTime?

  @@index([restaurantId, purpose, createdAt])
}

// ---------- Catering leads (milestone 3a) ----------

enum LeadStatus {
  NEW
  DRAFTED
  APPROVED
  EXCLUDED
}

/// A nearby business found through Google Places (or the fake provider).
/// Google's terms limit storing Place content, so rows are refreshed or
/// removed after 30 days; only placeId is kept long-term.
model Lead {
  id                String     @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  placeId           String
  source            String
  name              String
  /// office | coworking | school | clinic | gym | venue | other
  category          String
  types             String[]
  address           String
  latitude          Float
  longitude         Float
  distanceMiles     Float
  website           String?
  phone             String?
  ratingCount       Int?
  businessStatus    String?
  fitScore          Int
  scoreReasons      String[]
  status            LeadStatus @default(NEW)
  excludeReason     String?
  fetchedAt         DateTime
  /// When contacts were last looked up for this lead's website
  contactsCheckedAt DateTime?
  contacts          Contact[]
  drafts            Draft[]
  venueFor          Event[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([restaurantId, placeId])
  @@index([restaurantId, status, fitScore])
  @@index([restaurantId, category, distanceMiles])
}

model Contact {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name         String?
  role         String?
  email        String
  /// Hunter's confidence score, 0–100
  confidence   Int?
  /// "valid" | "accept_all" | "unknown" | "invalid" | null when not checked
  verification String?
  /// "hunter" | "owner" | "fake"
  source       String
  drafts       Draft[]
  createdAt    DateTime @default(now())

  @@unique([leadId, email])
}

model LeadScan {
  id               String     @id @default(cuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  status           JobStatus  @default(RUNNING)
  placesProvider   String
  contactsProvider String
  eventsProvider   String
  leadsFound       Int        @default(0)
  contactsFound    Int        @default(0)
  eventsFound      Int        @default(0)
  pitchesDrafted   Int        @default(0)
  message          String?
  createdAt        DateTime   @default(now())
  finishedAt       DateTime?

  @@index([restaurantId, createdAt])
}

/// An upcoming local event that could need catering.
model Event {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  /// "predicthq" | "ticketmaster" | "web" (Gemini + Google Search) | "fake"
  source        String
  externalId    String
  title         String
  /// conference | expo | sports | community | concert | school | other
  category      String
  startsAt      DateTime
  endsAt        DateTime?
  venueName     String?
  venueAddress  String?
  latitude      Float?
  longitude     Float?
  distanceMiles Float?
  attendance    Int?
  organizer     String?
  /// One or two sentences about the event, from the source
  description   String?
  url           String?
  /// The lead for this event's venue, when it could be matched to a nearby place
  venueLeadId   String?
  venueLead     Lead?      @relation(fields: [venueLeadId], references: [id], onDelete: SetNull)
  fitScore      Int
  scoreReasons  String[]
  fetchedAt     DateTime
  drafts        Draft[]
  createdAt     DateTime   @default(now())

  @@unique([restaurantId, source, externalId])
  @@index([restaurantId, startsAt])
  @@index([restaurantId, category, startsAt])
}

// ---------- Caching and shared limits (scaling) ----------

/// Shared cache for external lookups (Google Places, Hunter, web search,
/// event APIs), reused across restaurants and server processes.
model CacheEntry {
  key       String   @id
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Request pacing shared by every server and worker process, e.g. the
/// Gemini free tier's requests per minute.
model RateSlot {
  key  String   @id
  /// The earliest time the next request may start
  next DateTime
}

/// Requests to a metered API per day (Pacific time, when Google's free
/// quotas reset), and the limit learned from the provider's own error reply.
model ApiUsage {
  /// e.g. "gemini:2026-10-25"
  key            String    @id
  provider       String
  day            String
  count          Int       @default(0)
  /// The daily limit Google reported in a "quota exceeded" reply, if any
  limit          Int?
  /// No requests before this time (the daily quota is used up)
  exhaustedUntil DateTime?
  updatedAt      DateTime  @updatedAt
}

// ---------- Sending (milestone 3b) ----------

enum PipelineStage {
  NONE // not approved yet, or nothing to send
  SCHEDULED // approved; the first email is waiting for its send slot
  CONTACTED // the first email went out
  REPLIED
  QUOTE // the owner sent a quote
  WON
  LOST
  UNSUBSCRIBED
  BOUNCED
}

/// The owner's Gmail, connected for sending and reading replies. Tokens are encrypted.
model GmailAccount {
  id                   String     @id @default(cuid())
  restaurantId         String     @unique
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  email                String
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  scopes               String
  /// Last problem talking to Gmail (e.g. access revoked); sending pauses until reconnected
  error                String?
  lastReplyCheckAt     DateTime?
  connectedAt          DateTime   @default(now())
}

enum EmailStep {
  FIRST
  FOLLOWUP_1
  FOLLOWUP_2
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
}

/// One email of a pitch's sequence: the first email and up to two follow-ups in the same thread.
model OutboundEmail {
  id             String      @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  draftId        String
  draft          Draft       @relation(fields: [draftId], references: [id], onDelete: Cascade)
  step           EmailStep
  toEmail        String
  subject        String
  body           String
  status         EmailStatus @default(SCHEDULED)
  scheduledFor   DateTime
  sentAt         DateTime?
  gmailMessageId String?
  gmailThreadId  String?
  /// The Message-ID header, so follow-ups thread under the first email
  rfcMessageId   String?
  attempts       Int         @default(0)
  error          String?
  createdAt      DateTime    @default(now())

  @@unique([draftId, step])
  @@index([status, scheduledFor])
  @@index([restaurantId, sentAt])
}

/// Addresses that must never be emailed again by this restaurant: unsubscribed, bounced or removed by the owner.
model Suppression {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  email        String
  /// "unsubscribed" | "bounced" | "owner" | "replied-stop"
  reason       String
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, email])
}
