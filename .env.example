# Copy to .env and fill in.
DATABASE_URL="postgresql://app:app@localhost:5432/restaurant_growth"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""

# Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local development only: shows a "Continue as demo owner" button on the sign-in page.
DEV_LOGIN="true"

# ---------- AI ----------
# One free Gemini key runs both the copywriter and the AI analyst.
# Get it at https://aistudio.google.com (Get API key → Create API key). No card needed.
GEMINI_API_KEY=""
# "gemini-flash-latest" always points to Google's current Flash model. If a named model is retired,
# the app switches to the one Google suggests and logs a warning.
GEMINI_MODEL="gemini-flash-latest"
# Most Gemini requests per minute from this app (the free tier allows about 10). Raise it on a paid project.
GEMINI_RPM="10"
# Optional cap on Gemini requests per Pacific day. Without it, the app learns Google's daily limit from its
# first "quota exceeded" reply and pauses AI work until midnight Pacific instead of retrying.
GEMINI_RPD=""
# Most AI requests (steps) per analysis run
ANALYST_MAX_TURNS="10"

# Who writes the emails and offers: "gemini" (default), "anthropic" (Claude) or "ollama" (a local model).
# There's no pre-written fallback: if the AI is busy or over its free limit, jobs wait and try again.
LLM_PROVIDER="gemini"
# Who studies your data and picks offers and leads: "gemini" (default), "anthropic", "ollama" or "off" (rule ideas only).
ANALYST_PROVIDER="gemini"

# Later, to switch to Claude: set both providers to "anthropic" and add the key (https://console.anthropic.com).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
# Claude model for the analyst, e.g. claude-opus-5-5 (best), claude-sonnet-5-5, claude-haiku-5-5 (cheapest)
ANALYST_MODEL=""
# Optional for Claude: low | medium | high | xhigh | max
ANALYST_EFFORT=""

# For "ollama": install from https://ollama.com, then: ollama pull qwen2.5:7b-instruct
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"

# Most new drafts (offers and pitches together) per restaurant per day
DAILY_DRAFT_CAP="40"

# ---------- Catering leads (milestone 3a) ----------
# Area scan: "google" (Places API (New) + Geocoding API; needs GOOGLE_MAPS_API_KEY), "fake" (sample businesses, dev only) or "off".
PLACES_PROVIDER="off"
GOOGLE_MAPS_API_KEY=""
# Contact lookup: "hunter" (needs HUNTER_API_KEY), "fake" (dev only) or "off".
CONTACTS_PROVIDER="off"
HUNTER_API_KEY=""
# Hunter is used only when you click Generate pitch for a business without a contact.
# Most businesses and events the "AI suggests" button marks
PITCHES_PER_SCAN="15"
# Web search for events (Gemini + Google Search) is on whenever GEMINI_API_KEY is set; "off" turns it off.
WEB_EVENTS=""
# Local events: each source is on when its key is set. EVENTS_PROVIDER="fake" uses sample events instead (dev only).
EVENTS_PROVIDER=""
PREDICTHQ_API_KEY=""
# PredictHQ's free plan only searches saved locations: create one around the store and put its id here.
PREDICTHQ_LOCATION_ID=""
TICKETMASTER_API_KEY=""

# ---------- Background jobs and caching ----------
# "false" on web servers when a separate worker (npm run worker) runs the jobs. Leave empty for local development.
JOBS_IN_WEB=""
# How often a worker checks for new jobs (ms)
WORKER_POLL_MS="2000"
# "off" turns off the shared cache for Google, Hunter, web search and event APIs
CACHE=""

# ---------- Sending (milestone 3b) ----------
# The app's public address, used in Gmail's redirect and in unsubscribe links
APP_URL="http://localhost:3000"
# "fake" uses a local test mailbox instead of Gmail (development only)
GMAIL_PROVIDER=""
# How often to look for replies in Gmail (minutes)
REPLY_CHECK_MINUTES="10"
