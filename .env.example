# Copy to .env and fill in.
DATABASE_URL="postgresql://app:app@localhost:5432/restaurant_growth"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""

# Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local development only: shows a "Continue as demo owner" button on the sign-in page.
DEV_LOGIN="true"

# ---------- AI ----------
# Claude writes the emails and runs the analysis. Key from https://platform.claude.com (API keys).
LLM_PROVIDER="anthropic"
ANALYST_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Model for both. claude-opus-5-5 ($4/$20 per million tokens in/out) is the default; claude-sonnet-5-5 ($2/$10)
# and claude-haiku-5-5 ($0.10/$0.50) cost less. ANALYST_MODEL overrides it for the analysis only.
ANTHROPIC_MODEL="claude-opus-5-5"
ANALYST_MODEL=""
# How hard the analyst thinks: low | medium (Opus 5.5's default) | high | xhigh | max. Emails always use low.
ANALYST_EFFORT=""
# Most AI requests per offer analysis. The main data goes with the first request, so most runs need 1–2.
ANALYST_MAX_TURNS="4"

# Other AI providers: LLM_PROVIDER / ANALYST_PROVIDER = "gemini" (free tier) or "ollama" (on this computer).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
# When Gemini Flash is overloaded, requests go to this lighter model for 5 minutes. "off" turns it off.
GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"
# Gemini free-tier pacing: requests per minute, and an optional cap per Pacific day.
GEMINI_RPM="10"
GEMINI_RPD=""

# For "ollama": install from https://ollama.com, then: ollama pull qwen2.5:7b-instruct
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"
# How much of each request the local model reads (Ollama's own default, 4096, cuts off the lead list)
OLLAMA_NUM_CTX="16384"
# Local models are slower than Gemini: give each AI request this long before giving up (e.g. "300")
AI_TIMEOUT_SECONDS=""

# Most new drafts (offers and pitches together) per restaurant per day
DAILY_DRAFT_CAP="40"

# ---------- Catering leads (milestone 3a) ----------
# Area scan: "google" (Places API (New) + Geocoding API; needs GOOGLE_MAPS_API_KEY), "fake" (sample businesses, dev only) or "off".
PLACES_PROVIDER="off"
GOOGLE_MAPS_API_KEY=""
# Contact lookup: "hunter" (needs HUNTER_API_KEY), "fake" (dev only) or "off".
CONTACTS_PROVIDER="off"
HUNTER_API_KEY=""
# Hunter is used only when you click Generate pitch for a business without a contact.
# How many businesses and events "AI suggests" recommends (one AI request, no pitches written)
AI_SUGGESTIONS="20"
# Web search for events (one Gemini request with Google Search) runs only when you click "Search the web for
# events" on the Events tab. "on" adds it to every scan; "off" hides the button.
WEB_EVENTS=""
# Local events: each source is on when its key is set. EVENTS_PROVIDER="fake" uses sample events instead (dev only).
EVENTS_PROVIDER=""
PREDICTHQ_API_KEY=""
# PredictHQ's free plan only searches saved locations: create one around the store and put its id here.
PREDICTHQ_LOCATION_ID=""
TICKETMASTER_API_KEY=""

# ---------- Background jobs and caching ----------
# "false" on web servers when a separate worker (npm run worker) runs the jobs. Leave empty for local development.
JOBS_IN_WEB=""
# How often a worker checks for new jobs (ms)
WORKER_POLL_MS="2000"
# "off" turns off the shared cache for Google, Hunter, web search and event APIs
CACHE=""

# ---------- Sending (milestone 3b) ----------
# The app's public address, used in Gmail's redirect and in unsubscribe links
APP_URL="http://localhost:3000"
# "fake" uses a local test mailbox instead of Gmail (development only)
GMAIL_PROVIDER=""
# How often to look for replies in Gmail (minutes)
REPLY_CHECK_MINUTES="10"

# Switched off for now (set to "on" to bring them back):
# Hunter contact lookup when a pitch is written
CONTACT_LOOKUP="off"
# Sending from Gmail (pitches, follow-ups, customer offers), reply checks and the pipeline
EMAIL_SENDING="off"
