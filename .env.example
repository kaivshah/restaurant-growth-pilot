# Copy to .env and fill in.
DATABASE_URL="postgresql://app:app@localhost:5432/restaurant_growth"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""

# Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local development only: shows a "Continue as demo owner" button on the sign-in page.
DEV_LOGIN="true"

# Who writes offer copy: "template" (free, no key), "ollama" (free, local model) or "anthropic" (Claude).
LLM_PROVIDER="template"
# For LLM_PROVIDER=ollama — install from https://ollama.com, then: ollama pull qwen2.5:7b-instruct
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b-instruct"
# For LLM_PROVIDER=anthropic — key from https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
# Most new drafts per restaurant per day
DAILY_DRAFT_CAP="20"

# AI analyst: studies all uploaded data with read-only tools and recommends offers.
# "off" (default: standard ideas only), "anthropic" (uses ANTHROPIC_API_KEY) or "ollama" (local, uses OLLAMA_URL).
ANALYST_PROVIDER="off"
# e.g. claude-opus-5-5 (best), claude-sonnet-5-5, claude-haiku-5-5 (cheapest), or an Ollama model like qwen2.5:7b-instruct
ANALYST_MODEL="claude-opus-5-5"
# Optional for Claude: low | medium | high | xhigh | max (leave empty for the model's default)
ANALYST_EFFORT=""
